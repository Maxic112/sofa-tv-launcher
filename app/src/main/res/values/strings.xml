    <!-- Key service -->
    <string name="service_label">Sofa TV: remote keys</string>
    <string name="service_description">Intercepts the Home key and remaps remote keys in Sofa TV, shows the status panel and runs the sleep timer. Receives key presses and the name of the open app. Reads screen content only while memory cleanup runs in “force stop” mode, to press “Force stop” in the app settings.</string>

